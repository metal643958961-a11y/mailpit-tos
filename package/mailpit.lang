[zh-cn]
name = "Mailpit"
auth = "316z666"
descript = "捕获 NAS 本机应用发出的 SMTP 测试邮件，在网页收件箱检查内容。"
important = "先在应用 config 目录创建 auth.htpasswd 账户文件，确保 UID 1000 可读且可写 data 目录，然后启动。仅在受信任网络访问，本机 SMTP 端口 11025。"
release_note = "TOS x86_64 1.33.0.2: category, persistence and first-start initialization corrections."

[zh-hk]
name = "Mailpit"
auth = "316z666"
descript = "擷取 NAS 本機應用程式送出的 SMTP 測試郵件，在網頁收件匣檢視內容。"
important = "啟動前請在應用程式 config 目錄建立 auth.htpasswd 帳戶檔案，確保 UID 1000 可讀取且可寫入 data 目錄。僅在受信任網路存取，本機 SMTP 連接埠為 11025。"
release_note = "TOS x86_64 1.33.0.2: category, persistence and first-start initialization corrections."

[en-us]
name = "Mailpit"
auth = "316z666"
descript = "Capture SMTP test messages from this NAS and inspect them in the web inbox."
important = "Before starting, provide config/auth.htpasswd for the inbox and a writable data directory (UID 1000). Use a trusted network. Local SMTP port: 11025."
release_note = "TOS x86_64 1.33.0.2: category, persistence and first-start initialization corrections."

